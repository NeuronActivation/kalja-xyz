{
	"name": "kalja.xyz",
	"version": "1.2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeuronActivation/kalja-xyz.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:e2e": "playwright test",
		"test:coverage": "vitest run --coverage --coverage.reporter=json-summary",
		"lint": "eslint .",
		"format": "prettier --write src",
		"format:check": "prettier --check src"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/coverage-v8": "^5.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^20.14.5",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/shrikhand": "^5.3.0",
		"svelte-i18n": "^4.0.1"
	},
	"allowScripts": {
		"es5-ext": false,
		"esbuild": false
	}
}
