{
	"name": "kalja.xyz",
	"version": "1.2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeuronActivation/kalja-xyz.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"test:coverage": "vitest run --coverage --coverage.reporter=json-summary",
		"lint": "eslint .",
		"format": "prettier --write src",
		"format:check": "prettier --check src"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/shrikhand": "^5.3.0",
		"svelte-i18n": "^4.0.1"
	},
	"allowScripts": {
		"es5-ext": false,
		"esbuild": false
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"prettier": {
		"useTabs": true,
		"tabWidth": 4,
		"printWidth": 100,
		"semi": true,
		"singleQuote": true,
		"svelteIndentScriptAndStyle": false,
		"plugins": [
			"prettier-plugin-svelte"
		]
	}
}
